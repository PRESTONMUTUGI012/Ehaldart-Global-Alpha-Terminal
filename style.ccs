/* Custom Poster Wallpaper & Cyber Glow Theme matching Ehaldart Global FX poster */
body.poster-bg {
    background: radial-gradient(circle at 50% 15%, #064e3b 0%, #022c22 35%, #020b0a 70%, #010404 100%) !important;
    background-attachment: fixed !important;
}

.poster-card {
    background: rgba(2, 22, 17, 0.9) !important;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.7);
}

/* Pulse animation for connection badge */
.pulse-green {
    animation: pulseGreen 1.5s infinite;
}

@keyframes pulseGreen {
    0% { 
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); 
    }
    70% { 
        box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); 
    }
    100% { 
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); 
    }
}

/* Glow effect for SVG line chart */
.chart-glow {
    filter: drop-shadow(0px 0px 10px rgba(16, 185, 129, 0.6));
}

/* Custom Scrollbar */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}

::-webkit-scrollbar-track {
    background: #010404;
}

::-webkit-scrollbar-thumb {
    background: #065f46;
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: #059669;
}
